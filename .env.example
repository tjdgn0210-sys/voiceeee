# Example values only. Copy to .env (never commit .env). EXPO_PUBLIC_* values end up inside the app, so never put secrets here.

# Settings > information. A row appears only when its value is set.
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_CONTACT_EMAIL=help@example.com

# Address of the AI gateway (see server/.env.example for the server side).
EXPO_PUBLIC_AI_SERVER_URL=https://api.example.com
